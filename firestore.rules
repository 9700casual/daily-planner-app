rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // This security rules file assumes the following data structures:
    //
    // Collection: artifacts/{appId}/users/{userId}/todos
    // Document ID: {todoId} (auto-generated by Firestore)
    // Fields:
    //   - text: string (required, 1..500 chars) - Task description
    //   - type: string (required, 'personal' or 'work') - Task category
    //   - completed: bool (required) - Completion state
    //   - createdAt: number (required, > 0, immutable) - Creation epoch ms
    //
    // Collection: artifacts/{appId}/users/{userId}/schedule
    // Document ID: {eventId} (auto-generated by Firestore)
    // Fields:
    //   - time: string (required, 1..20 chars) - Start time (e.g. "09:00")
    //   - endTime: string (required, 0..20 chars) - Optional end time
    //   - title: string (required, 1..200 chars) - Event title
    //   - duration: string (required, 0..50 chars) - Duration label
    //   - color: string (required, 1..150 chars) - CSS color classes
    //   - date: string (required, 1..50 chars) - Date string
    //   - createdAt: number (required, > 0, immutable) - Creation epoch ms
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (for user-scoped paths)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate required fields exist
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Validate string length bounds
    function validStringLength(value, minLen, maxLen) {
      return value is string &&
        value.size() >= minLen &&
        value.size() <= maxLen;
    }

    // Validate that a numeric value is positive (> 0)
    function isPositiveNumber(value) {
      return value is number && value > 0;
    }

    // Validate that immutable fields have not changed on update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators (Used in both create and update)
    // ===============================================================

    function isValidTodo(data) {
      let allowedFields = ['text', 'type', 'completed', 'createdAt'];
      return hasRequiredFields(data, allowedFields) &&
        hasOnlyAllowedFields(data, allowedFields) &&
        validStringLength(data.text, 1, 500) &&
        data.type is string &&
        data.type in ['personal', 'work'] &&
        data.completed is bool &&
        isPositiveNumber(data.createdAt);
    }

    function isValidScheduleEvent(data) {
      let allowedFields = [
        'time',
        'endTime',
        'title',
        'duration',
        'color',
        'date',
        'createdAt'
      ];
      return hasRequiredFields(data, allowedFields) &&
        hasOnlyAllowedFields(data, allowedFields) &&
        validStringLength(data.time, 1, 20) &&
        validStringLength(data.endTime, 0, 20) &&
        validStringLength(data.title, 1, 200) &&
        validStringLength(data.duration, 0, 50) &&
        validStringLength(data.color, 1, 150) &&
        validStringLength(data.date, 1, 50) &&
        isPositiveNumber(data.createdAt);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /artifacts/{appId}/users/{userId}/todos/{todoId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidTodo(request.resource.data);
      allow update: if isOwner(userId) &&
        isValidTodo(request.resource.data) &&
        areImmutableFieldsUnchanged(['createdAt']);
      allow delete: if isOwner(userId);
    }

    match /artifacts/{appId}/users/{userId}/schedule/{eventId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidScheduleEvent(request.resource.data);
      allow update: if isOwner(userId) &&
        isValidScheduleEvent(request.resource.data) &&
        areImmutableFieldsUnchanged(['createdAt']);
      allow delete: if isOwner(userId);
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
